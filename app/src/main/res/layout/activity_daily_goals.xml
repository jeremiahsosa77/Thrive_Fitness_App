<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/goalsContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar for streak & back button -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_green"
        app:titleTextColor="@color/white"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar">

        <TextView
            android:id="@+id/streakText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Streak: 0"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:layout_gravity="end"
            android:paddingEnd="16dp" />
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginTop="?attr/actionBarSize"
        android:backgroundTint="@color/background_white"
        android:gravity="top">

        <!-- Daily Task Checkboxes -->
        <CheckBox
            android:id="@+id/task1"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Walk 5,000 steps"
            android:textColor="@color/dark_text"
            android:backgroundTint="@color/background_white"
            android:textSize="18sp"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/task2"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Do 25 push ups"
            android:textColor="@color/dark_text"
            android:backgroundTint="@color/background_white"
            android:textSize="18sp"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/task3"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Drink 8 cups of water"
            android:textSize="18sp"
            android:textColor="@color/dark_text"
            android:backgroundTint="@color/background_white"
            android:padding="8dp" />


        <CheckBox
            android:id="@+id/task4"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Stretch for 5 minutes"
            android:textColor="@color/dark_text"
            android:backgroundTint="@color/background_white"
            android:textSize="18sp"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/task5"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Do 20 squats"
            android:textColor="@color/dark_text"
            android:backgroundTint="@color/background_white"
            android:textSize="18sp"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/task6"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Hold a 30 second plank"
            android:textColor="@color/dark_text"
            android:backgroundTint="@color/background_white"
            android:textSize="18sp"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/task7"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Do 10 jumping jacks"
            android:textColor="@color/dark_text"
            android:backgroundTint="@color/background_white"
            android:textSize="18sp"
            android:padding="8dp" />

        <CheckBox
            android:id="@+id/task8"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Track all meals for the day"
            android:textColor="@color/dark_text"
            android:backgroundTint="@color/background_white"
            android:textSize="18sp"
            android:padding="8dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>